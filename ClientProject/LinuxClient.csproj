<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <PackageId />
        <Authors>Hadrada,Maplewheels</Authors>
    </PropertyGroup>

    <ItemGroup>
      <Reference Include="Barotrauma">
        <HintPath>..\Refs\Linux\Barotrauma.dll</HintPath>
      </Reference>
      <Reference Include="BarotraumaCore">
        <HintPath>..\Refs\Linux\BarotraumaCore.dll</HintPath>
      </Reference>
      <Reference Include="Farseer.NetStandard">
        <HintPath>..\Refs\Farseer.NetStandard.dll</HintPath>
      </Reference>
      <Reference Include="Lidgren.NetStandard">
        <HintPath>..\Refs\Lidgren.NetStandard.dll</HintPath>
      </Reference>
      <Reference Include="Mono.Cecil">
        <HintPath>..\Refs\Mono.Cecil.dll</HintPath>
      </Reference>
      <Reference Include="MonoGame.Framework.Linux.NetStandard">
        <HintPath>..\Refs\MonoGame.Framework.Linux.NetStandard.dll</HintPath>
      </Reference>
      <Reference Include="MoonSharp.Interpreter">
        <HintPath>..\Refs\MoonSharp.Interpreter.dll</HintPath>
      </Reference>
      <Reference Include="XNATypes">
        <HintPath>..\Refs\XNATypes.dll</HintPath>
      </Reference>
    </ItemGroup>

    <Import Project="..\SharedProject\SharedProject.projitems" Label="Shared" />
    <Import Project="../Build.props" />
  <ItemGroup>
    <None Include="../Build.props" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Assets\Assets.csproj" />
  </ItemGroup>
    <PropertyGroup>
        <RootNamespace>$(SolutionName.Replace(" ", "_"))</RootNamespace>
        <PlatformTarget>x64</PlatformTarget>
        <GenerateDocumentationFile>False</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DefineConstants>TRACE;CLIENT;LINUX</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DefineConstants>TRACE;CLIENT;LINUX</DefineConstants>
    </PropertyGroup>

    <Target Name="CopyFiles" AfterTargets="Build">
        <ItemGroup>
            <Assemblies Include="$(TargetDir)$(TargetName).dll" />
            <DepsFiles Include="$(TargetDir)$(TargetName).deps.json" />
        </ItemGroup>
        <Copy SourceFiles="@(Assemblies)" DestinationFiles="$(ModDeployDir)bin\Client\Linux\$(TargetName).dll" />
        <Copy SourceFiles="@(DepsFiles)" DestinationFiles="$(ModDeployDir)bin\Client\Linux\$(TargetName).deps.json" />
    </Target>
    
</Project>
